# ============================================================================
# SQUADRON · MAINNET PRODUCTION CONFIGURATION TEMPLATE
# Copy values into .env when cutting over from Devnet to Solana Mainnet-Beta
# ============================================================================

# 1. Database (SQLite local or PostgreSQL on Railway/Supabase)
DATABASE_URL="file:./dev.db"

# 2. Solana Mainnet-Beta RPC (Use Helius, QuickNode, or Shyft for low-latency landing)
NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"
NEXT_PUBLIC_SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"
SOLANA_RPC="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"

# 3. Vault Keypair AES-256-GCM Master Key (64 hex chars / 32 bytes)
# Generate a fresh production key with: openssl rand -hex 32
VAULT_MASTER_KEY="REPLACE_WITH_64_HEX_CHAR_SECRET_KEY_FROM_OPENSSL_RAND_HEX_32"

# 4. Squadron Protocol Revenue & Treasury Settings
# Example: 200 BPS = 2.00% protocol cut on vault fee distributions (set 0 for 0% fee)
SQUADRON_TREASURY_WALLET="REPLACE_WITH_YOUR_SOLANA_TREASURY_PUBLIC_KEY"
PLATFORM_FEE_BPS="200"
MIN_PAYOUT_LAMPORTS="2500000"

# 5. IPFS & Pump.fun Developer API (Optional — falls back to Pump.fun IPFS & Hybrid DB Squads)
PINATA_JWT=""
PUMP_API_KEY=""
PUMP_API_BASE="https://api.pump.fun/v1"
