# ── Database ──────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Solana ────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"          # devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_RPC="https://api.devnet.solana.com"
SOLANA_RPC="https://api.devnet.solana.com"   # server/worker RPC (use a paid RPC in prod)

# ── pump.fun Developer API (server-only, never expose) ───
# Leave empty to use mock squads. Apply at https://developers.pump.fun
PUMP_API_KEY=""
PUMP_API_BASE_URL=""                         # default https://api.pump.fun/v1 ; devnet: https://api-devnet.pump.fun/v1
SQUAD_PROVIDER=""                            # set to "mock" to force mock data

# ── Vaults (custodial splitter, v1) ──────────────────────
# 32 bytes hex: openssl rand -hex 32
VAULT_ENCRYPTION_KEY=""

# ── Metadata upload (Pinata) ─────────────────────────────
PINATA_JWT=""
PINATA_GATEWAY="https://ipfs.io/ipfs"

# ── Platform fee (optional) ──────────────────────────────
PLATFORM_FEE_BPS="0"
PLATFORM_TREASURY=""

# ── Worker ───────────────────────────────────────────────
WORKER_CRON="*/10 * * * *"                   # sweep + distribute schedule
WORKER_PAYER_SECRET=""                       # base58 secret of a fee payer for sweep txs
MIN_PAYOUT_LAMPORTS="5000000"                # skip splits below 0.005 SOL
ROLE_WEIGHTS='{"OWNER":1,"ADMIN":1,"MEMBER":1}'
